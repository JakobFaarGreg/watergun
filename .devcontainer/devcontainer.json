{
    "name": "Python development",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspace",
    "runServices": [
        "mediamtx",
        "imageextractor"
    ],
    "forwardPorts": [
        8889,
        8554,
        8189
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "python.analysis.extraPaths": [
                    "/usr/local/lib/python3.12/site-packages"
                ],
                "python.terminal.useEnvFile": true
            }
        }
    }
}